# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local: npx supabase start — or hosted project URL)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-or-hosted-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-or-hosted-service-role-key

# AI Provider (draft normalization — manual workflow works when disabled)
AI_PROVIDER=disabled
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5:14b-instruct
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4000

# Embedding Provider (semantic search — full-text works when disabled)
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Optional OpenAI-compatible local endpoints (LM Studio, vLLM, etc.)
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=qwen/qwen3-14b
#
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_MODEL=text-embedding-model

# Optional legacy OpenAI cloud (not required for local development)
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
#
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
